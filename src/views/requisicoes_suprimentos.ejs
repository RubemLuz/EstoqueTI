<%- include('partials/app-start', { title, activePage: 'requisicoes' }) %>
      <div class="page-content">
        <section class="panel">
          <div class="supplies-toolbar">
            <div>
              <h2>Requisições de Suprimentos</h2>
              <p class="muted">Selecione os suprimentos e informe a quantidade solicitada na filial <%= filial %>.</p>
            </div>
          </div>

          <% if (success && success.length) { %>
            <div class="request-notice request-notice-success" role="status"><%= success.join(' ') %></div>
          <% } %>
          <% if (error && error.length) { %>
            <div class="request-notice request-notice-error" role="alert"><%= error.join(' ') %></div>
          <% } %>

          <form id="formRequisicao" method="post" action="/requisicoes-suprimentos">
            <input type="hidden" name="filial" value="<%= filial %>">
            <input type="hidden" name="itens" id="itensRequisicao" value="[]">
            <div class="request-items">
              <div id="listaItensRequisicao" class="request-list"></div>
              <p id="mensagemSemItens" class="muted">Nenhum suprimento adicionado.</p>
            </div>
            <div class="supplies-actions">
              <button class="button-primary" id="adicionarItemRequisicao" type="button">Adicionar</button>
              <button class="button-primary" id="enviarRequisicao" type="submit" disabled>Requisitar</button>
            </div>
          </form>

          <dialog id="dialogSuprimento" class="request-dialog">
            <form method="dialog" id="formItemRequisicao">
              <h3>Adicionar suprimento</h3>
              <label>Suprimento
                <select id="suprimentoSelecionado" required>
                  <option value="">Selecione</option>
                  <% suprimentos.forEach((suprimento) => { %>
                    <option value="<%= suprimento.id %>"><%= suprimento.nome %> - <%= suprimento.impressora || '-' %> - Qnt atual: <%= suprimento.quantidadeAtual %></option>
                  <% }) %>
                </select>
              </label>
              <label>Quantidade
                <input id="quantidadeSuprimento" type="number" min="1" value="1" required>
              </label>
              <div class="supplies-actions">
                <button class="button-primary" id="confirmarItemRequisicao" value="default" type="button">OK</button>
                <button class="button-secondary" type="button" data-close-supply-dialog>Fechar</button>
              </div>
            </form>
          </dialog>

          <div class="request-history">
            <h3>Requisições registradas</h3>
            <div class="table-scroll">
              <table>
                <thead><tr><th>Número da requisição</th><th>Total de materiais</th><th>Data</th><th>Status</th><th>Ação</th></tr></thead>
                <tbody>
                  <% if (requisicoes.length) { %>
                    <% requisicoes.forEach((requisicao) => { %>
                      <tr>
                        <td><%= requisicao.id %></td>
                        <td><%= requisicao.itens.reduce((total, item) => total + Number(item.quantidade || 0), 0) %></td>
                        <td><%= new Date(requisicao.data).toLocaleString('pt-BR') %></td>
                        <td><span class="request-status <%= requisicao.status === 'Recebido' ? 'request-status-received' : 'request-status-pending' %>"><%= requisicao.status %></span></td>
                        <td><button class="button-primary" type="button" data-open-request="<%= requisicao.id %>">Abrir requisição</button></td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr><td class="empty-state" colspan="5">Nenhuma requisição registrada nesta filial.</td></tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>

          <% requisicoes.forEach((requisicao) => { %>
            <dialog id="detalhe-requisicao-<%= requisicao.id %>" class="request-dialog request-detail-dialog">
              <h3>Requisição <%= requisicao.id %></h3>
              <p class="muted">Data: <%= new Date(requisicao.data).toLocaleString('pt-BR') %> · Status: <%= requisicao.status %></p>
              <form id="receber-requisicao-<%= requisicao.id %>" method="post" action="/requisicoes-suprimentos/<%= requisicao.id %>/receber" data-receive-form>
                <input type="hidden" name="filial" value="<%= filial %>">
                <div class="table-scroll">
                  <table>
                    <thead><tr><th>Nome</th><th>Impressora</th><th>Tipo</th><th>Quantidade</th></tr></thead>
                    <tbody>
                      <% requisicao.itens.forEach((item, index) => { %>
                        <tr>
                          <td><%= item.nome %></td>
                          <td><%= item.impressora || '-' %></td>
                          <td><%= item.tipo || '-' %></td>
                          <td>
                            <input
                              class="request-quantity"
                              type="number"
                              name="quantidades[<%= index %>]"
                              min="0"
                              step="1"
                              required
                              value="<%= requisicao.status === 'Recebido' ? (item.quantidadeRecebida ?? item.quantidade) : item.quantidade %>"
                              data-original-value="<%= requisicao.status === 'Recebido' ? (item.quantidadeRecebida ?? item.quantidade) : item.quantidade %>"
                              aria-label="Quantidade recebida de <%= item.nome %>"
                              disabled                            >
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </form>
              <div class="request-dialog-actions">
                <button class="button-secondary" type="button" data-close-request>Fechar</button>
                <% if (requisicao.status === 'Pendente') { %>
                  <button class="button-primary" type="button" form="receber-requisicao-<%= requisicao.id %>" data-confirm-receipt>Receber</button>
                <% } %>
                <form method="post" action="/requisicoes-suprimentos/<%= requisicao.id %>/excluir" data-delete-request>
                  <input type="hidden" name="filial" value="<%= filial %>">
                  <button class="button-danger" type="submit">Excluir</button>
                </form>
              </div>
            </dialog>
          <% }) %>
        </section>
      </div>
<script src="/js/requisicoes-suprimentos.js"></script>
<%- include('partials/app-end') %>
