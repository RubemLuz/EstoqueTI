<%- include('partials/app-start', { title, activePage }) %>
      <div class="page-content">
        <section class="panel">
          <div class="supplies-toolbar">
            <div>
              <h2>Transferências entre filiais</h2>
              <p class="muted">Envie itens da filial <%= filial %> ou solicite itens disponíveis em outra filial.</p>
            </div>
          </div>

          <% if (success && success.length) { %>
            <div class="request-notice request-notice-success" role="status"><%= success.join(' ') %></div>
          <% } %>
          <% if (error && error.length) { %>
            <div class="request-notice request-notice-error" role="alert"><%= error.join(' ') %></div>
          <% } %>

          <form id="formTransferencia" method="post" action="/transferencias">
            <input type="hidden" name="filial" value="<%= filial %>" data-current-branch="<%= filial %>">
            <input type="hidden" name="itens" value="[]" data-transfer-items>
            <div class="transfer-fields">
              <label>Operação
                <select name="modalidade" data-transfer-mode required>
                  <option value="envio">Enviar itens desta filial</option>
                  <option value="requisicao">Solicitar itens de outra filial</option>
                </select>
              </label>
              <label><span data-transfer-branch-title>Filial destino</span>
                <select name="filialDestino" data-transfer-branch required>
                  <option value="">Selecione uma filial</option>
                  <% [1, 3, 4].filter((numero) => numero !== filial).forEach((numero) => { %>
                    <option value="<%= numero %>">Filial <%= numero %></option>
                  <% }) %>
                </select>
              </label>
            </div>
            <div class="request-items">
              <div class="request-list" data-transfer-list></div>
              <p class="muted" data-transfer-empty>Nenhum item adicionado.</p>
            </div>
            <div class="supplies-actions">
              <button class="button-primary" type="button" data-open-transfer-dialog <%= produtosDisponiveis.length || suprimentosDisponiveis.length ? '' : 'disabled' %>>Adicionar equipamento ou suprimento</button>
              <button class="button-primary" type="submit" data-submit-transfer disabled>Criar transferência</button>
            </div>
            <% if (!produtosDisponiveis.length && !suprimentosDisponiveis.length) { %>
              <p class="muted">Não há equipamentos ou suprimentos com saldo disponível nas filiais.</p>
            <% } %>
          </form>

          <dialog class="request-dialog" data-transfer-dialog>
            <form method="dialog">
              <h3>Adicionar item à transferência</h3>
              <label>Tipo de item
                <select required data-transfer-type>
                  <option value="">Selecione</option>
                  <option value="produto">Equipamento / produto</option>
                  <option value="suprimento">Suprimento</option>
                </select>
              </label>
              <label>Buscar item
                <input type="search" placeholder="Digite o nome, modelo ou categoria" data-transfer-search disabled>
              </label>
              <label>Item
                <select required data-transfer-select disabled>
                  <option value="">Selecione o tipo primeiro</option>
                  <% produtosDisponiveis.forEach((produto) => { %>
                    <option
                      value="<%= produto._id %>"
                      data-item-type="produto"
                      data-filial="<%= produto.filialEstoque %>"
                      data-label="<%= `Filial ${produto.filialEstoque} · ${[produto.nome, produto.modelo || '-', produto.categoria || '-'].join(' - ')}` %>"
                      data-search="<%= [produto.nome, produto.modelo, produto.categoria, produto.informacaoExtra].filter(Boolean).join(' ') %>"
                      data-available="<%= Math.max(0, Math.floor(produto.quantidadeAtual - (produto.quantidadePendente || 0))) %>"
                      hidden
                    >
                      <%= produto.nome %>
                    </option>
                  <% }) %>
                  <% suprimentosDisponiveis.forEach((suprimento) => { %>
                    <option
                      value="<%= suprimento._id %>"
                      data-item-type="suprimento"
                      data-filial="<%= suprimento.filialEstoque %>"
                      data-label="<%= `Filial ${suprimento.filialEstoque} · ${[suprimento.nome, suprimento.impressora || '-', suprimento.tipo || '-'].join(' - ')}` %>"
                      data-search="<%= [suprimento.nome, suprimento.impressora, suprimento.tipo].filter(Boolean).join(' ') %>"
                      data-available="<%= Math.max(0, Math.floor(suprimento.quantidadeAtual - (suprimento.quantidadePendente || 0))) %>"
                      hidden
                    >
                      <%= suprimento.nome %>
                    </option>
                  <% }) %>
                </select>
              </label>
              <p class="muted" data-transfer-no-results hidden>Nenhum item disponível corresponde à busca.</p>
              <label>Quantidade
                <input type="number" min="1" step="1" value="1" required data-transfer-quantity>
              </label>
              <div class="supplies-actions">
                <button class="button-primary" type="button" data-add-transfer-item>Adicionar</button>
                <button class="button-secondary" type="button" data-close-transfer-dialog>Fechar</button>
              </div>
            </form>
          </dialog>

          <section class="transfer-history">
            <h3>Envios e solicitações da filial <%= filial %></h3>
            <div class="table-scroll">
              <table>
                <thead><tr><th>Data</th><th>Operação</th><th>Outra filial</th><th>Quantidade</th><th>Status</th><th>Ação</th></tr></thead>
                <tbody>
                  <% if (transferenciasEnviadas.length) { %>
                    <% transferenciasEnviadas.forEach((transferencia) => { %>
                      <tr>
                        <td><%= new Date(transferencia.data).toLocaleString('pt-BR') %></td>
                        <td><%= transferencia.modalidade === 'requisicao' ? 'Solicitação' : 'Envio direto' %></td>
                        <td><%= transferencia.modalidade === 'requisicao' ? 'Filial ' + transferencia.filialDestino : 'Filial ' + transferencia.filialDestino %></td>
                        <td><%= transferencia.itens.reduce((total, item) => total + Number(item.quantidade || 0), 0) %></td>
                        <td><span class="request-status <%= transferencia.status === 'Recebido' ? 'request-status-received' : transferencia.status === 'Rejeitado' ? 'request-status-rejected' : transferencia.status === 'Enviado' ? 'transfer-status-sent' : 'request-status-pending' %>"><%= transferencia.status %></span></td>
                        <td class="transfer-actions">
                          <button class="button-primary" type="button" data-open-transfer="<%= transferencia.id %>">Detalhes</button>
                          <% if (transferencia.modalidade === 'requisicao' && transferencia.status === 'Enviado') { %>
                            <form method="post" action="/transferencias/<%= transferencia.id %>/receber" data-confirm-transfer-receipt>
                              <input type="hidden" name="filial" value="<%= filial %>">
                              <button class="button-primary" type="submit">Confirmar recebimento</button>
                            </form>
                          <% } %>
                        </td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr><td class="empty-state" colspan="6">Nenhum envio ou solicitação criada por esta filial.</td></tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </section>

          <section class="transfer-history">
            <h3>Recebimentos e solicitações para atender na filial <%= filial %></h3>
            <div class="table-scroll">
              <table>
                <thead><tr><th>Data</th><th>Operação</th><th>Outra filial</th><th>Quantidade</th><th>Status</th><th>Ação</th></tr></thead>
                <tbody>
                  <% if (transferenciasRecebidas.length) { %>
                    <% transferenciasRecebidas.forEach((transferencia) => { %>
                      <tr>
                        <td><%= new Date(transferencia.dataEnvio || transferencia.data).toLocaleString('pt-BR') %></td>
                        <td><%= transferencia.modalidade === 'requisicao' ? 'Requisição recebida' : 'Recebimento' %></td>
                        <td><%= transferencia.modalidade === 'requisicao' ? 'Solicitada pela Filial ' + transferencia.filialOrigem : 'Filial ' + transferencia.filialOrigem %></td>
                        <td><%= transferencia.itens.reduce((total, item) => total + Number(item.quantidade || 0), 0) %></td>
                        <td>
                          <% const statusRecebimento = transferencia.status === 'Recebido' ? 'Recebido' : transferencia.status === 'Rejeitado' ? 'Rejeitado' : transferencia.status === 'Enviado' ? 'A caminho' : 'Solicitado'; %>
                          <span class="request-status <%= transferencia.status === 'Recebido' ? 'request-status-received' : transferencia.status === 'Rejeitado' ? 'request-status-rejected' : transferencia.status === 'Enviado' ? 'transfer-status-sent' : 'request-status-pending' %>"><%= statusRecebimento %></span>
                        </td>
                        <td class="transfer-actions">
                          <button class="button-primary" type="button" data-open-transfer="<%= transferencia.id %>">Detalhes</button>
                          <% if (transferencia.modalidade !== 'requisicao' && transferencia.status === 'Enviado') { %>
                            <form method="post" action="/transferencias/<%= transferencia.id %>/receber" data-confirm-transfer-receipt>
                              <input type="hidden" name="filial" value="<%= filial %>">
                              <button class="button-primary" type="submit">Confirmar recebimento</button>
                            </form>
                          <% } %>
                        </td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr><td class="empty-state" colspan="6">Nenhum recebimento ou solicitação direcionada a esta filial.</td></tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </section>

          <% [...transferenciasEnviadas, ...transferenciasRecebidas].forEach((transferencia) => { %>
            <dialog id="detalhe-transferencia-<%= transferencia.id %>" class="request-dialog request-detail-dialog">
              <h3><%= transferencia.modalidade === 'requisicao' ? 'Solicitação' : 'Transferência' %> <%= transferencia.id %></h3>
              <% if (transferencia.modalidade === 'requisicao') { %>
                <p class="muted">Solicitada pela Filial <%= transferencia.filialOrigem %> à Filial <%= transferencia.filialDestino %> em <%= new Date(transferencia.data).toLocaleString('pt-BR') %> por <%= transferencia.usuario %>. Status: <%= transferencia.status %></p>
              <% } else { %>
                <p class="muted">Enviada pela Filial <%= transferencia.filialOrigem %> à Filial <%= transferencia.filialDestino %> em <%= new Date(transferencia.data).toLocaleString('pt-BR') %> por <%= transferencia.usuario %>. Status: <%= transferencia.status %></p>
              <% } %>
              <% if (transferencia.dataEnvio) { %><p class="muted">Enviada em <%= new Date(transferencia.dataEnvio).toLocaleString('pt-BR') %>.</p><% } %>
              <% if (transferencia.dataRecebimento) { %><p class="muted">Recebida em <%= new Date(transferencia.dataRecebimento).toLocaleString('pt-BR') %>.</p><% } %>
              <% if (transferencia.observacaoRejeicao) { %><p class="request-notice request-notice-error"><strong>Motivo da rejeição:</strong> <%= transferencia.observacaoRejeicao %></p><% } %>
              <div class="table-scroll">
                <table>
                  <thead><tr><th>Tipo</th><th>Item</th><th>Modelo / identificação</th><th>Quantidade</th></tr></thead>
                  <tbody>
                    <% transferencia.itens.forEach((item) => { %>
                      <tr>
                        <td><%= item.tipoItem === 'produto' ? 'Equipamento / produto' : 'Suprimento' %></td>
                        <td><%= item.nome %></td>
                        <td><%= item.tipoItem === 'produto' ? [item.modelo, item.categoria, item.informacaoExtra].filter(Boolean).join(' · ') || '-' : [item.impressora, item.tipoSuprimento].filter(Boolean).join(' · ') || '-' %></td>
                        <td><%= item.quantidade %></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
              <div class="request-dialog-actions">
                <button class="button-secondary" type="button" data-close-transfer>Fechar</button>
                <% if (transferencia.modalidade !== 'requisicao' && transferencia.filialOrigem === filial && transferencia.status === 'Solicitado') { %>
                  <form method="post" action="/transferencias/<%= transferencia.id %>/enviar" data-send-transfer>
                    <input type="hidden" name="filial" value="<%= filial %>">
                    <button class="button-primary" type="submit">Enviar transferência</button>
                  </form>
                <% } %>
                <% if (transferencia.modalidade === 'requisicao' && transferencia.filialDestino === filial && transferencia.status === 'Solicitado') { %>
                  <form method="post" action="/transferencias/<%= transferencia.id %>/atender" data-send-transfer>
                    <input type="hidden" name="filial" value="<%= filial %>">
                    <button class="button-primary" type="submit">Atender e enviar</button>
                  </form>
                <% } %>
                <% if (transferencia.status === 'Enviado' && ((transferencia.modalidade === 'requisicao' && transferencia.filialOrigem === filial) || (transferencia.modalidade !== 'requisicao' && transferencia.filialDestino === filial))) { %>
                  <form method="post" action="/transferencias/<%= transferencia.id %>/receber" data-confirm-transfer-receipt>
                    <input type="hidden" name="filial" value="<%= filial %>">
                    <button class="button-primary" type="submit">Confirmar recebimento</button>
                  </form>
                <% } %>
              </div>
              <% if (transferencia.modalidade === 'requisicao' && transferencia.filialDestino === filial && transferencia.status === 'Solicitado') { %>
                <form method="post" action="/transferencias/<%= transferencia.id %>/rejeitar" class="transfer-reject-form" data-reject-transfer>
                  <input type="hidden" name="filial" value="<%= filial %>">
                  <label>Motivo da rejeição
                    <textarea name="observacao" rows="3" maxlength="500" required></textarea>
                  </label>
                  <button class="button-danger" type="submit">Rejeitar solicitação</button>
                </form>
              <% } %>
            </dialog>
          <% }) %>
        </section>
      </div>
<script src="/js/transferencias.js"></script>
<%- include('partials/app-end') %>
