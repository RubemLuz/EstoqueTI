<%- include('partials/app-start', { title, activePage }) %>
      <div class="page-content">
        <section class="panel">
          <div class="supplies-toolbar">
            <div>
              <h2>Saída de Suprimentos</h2>
              <p class="muted">Registre as retiradas e consulte o histórico da filial <%= filial %>.</p>
            </div>
            <a class="button-secondary" href="/suprimentos?filial=<%= filial %>">Voltar aos suprimentos</a>
          </div>

          <% if (success && success.length) { %>
            <div class="request-notice request-notice-success" role="status"><%= success.join(' ') %></div>
          <% } %>
          <% if (error && error.length) { %>
            <div class="request-notice request-notice-error" role="alert"><%= error.join(' ') %></div>
          <% } %>

          <h3>Registrar saída</h3>
          <form method="post" action="/saidas-suprimentos" data-withdrawal-form>
            <input type="hidden" name="filial" value="<%= filial %>">
            <input type="hidden" name="itens" value="[]" data-withdrawal-items>
            <div class="request-items">
              <div class="request-list" data-withdrawal-list></div>
              <p class="muted" data-withdrawal-empty>Nenhum suprimento selecionado.</p>
            </div>
            <div class="supplies-actions">
              <button class="button-primary" type="button" data-open-withdrawal-dialog <%= suprimentos.length ? '' : 'disabled' %>>Adicionar suprimento</button>
              <button class="button-primary" type="submit" data-submit-withdrawal disabled>Confirmar saída</button>
            </div>
            <% if (!suprimentos.length) { %>
              <p class="muted">Não há suprimentos ativos nesta filial.</p>
            <% } %>
          </form>

          <dialog class="request-dialog" data-withdrawal-dialog>
            <form method="dialog">
              <h3>Adicionar suprimento à saída</h3>
              <label>Suprimento
                <select required data-withdrawal-select>
                  <option value="">Selecione</option>
                  <% suprimentos.forEach((suprimento) => { %>
                    <option value="<%= suprimento.id %>" data-name="<%= suprimento.nome %>"><%= suprimento.nome %> - <%= suprimento.impressora || '-' %> - Qnt atual: <%= suprimento.quantidadeAtual %></option>
                  <% }) %>
                </select>
              </label>
              <label>Quantidade
                <input type="number" min="1" step="1" value="1" required data-withdrawal-quantity>
              </label>
              <div class="supplies-actions">
                <button class="button-primary" type="button" data-add-withdrawal-item>Adicionar</button>
                <button class="button-secondary" type="button" data-close-withdrawal-dialog>Fechar</button>
              </div>
            </form>
          </dialog>

          <div class="request-history">
            <div class="supplies-toolbar">
              <div>
                <h3>Histórico de saídas</h3>
                <p class="muted">Período: <%= periodo.dataInicio %> até <%= periodo.dataFim %></p>
              </div>
              <a class="button-primary" href="/saidas-suprimentos/relatorio?filial=<%= filial %>&periodo=personalizado&dataInicio=<%= periodo.dataInicio %>&dataFim=<%= periodo.dataFim %>">Baixar relatório TXT</a>
            </div>

            <div class="withdrawal-period-actions">
              <a class="button-secondary" href="/saidas-suprimentos?filial=<%= filial %>&periodo=semanal">Esta semana</a>
              <a class="button-secondary" href="/saidas-suprimentos?filial=<%= filial %>&periodo=mensal">Este mês</a>
            </div>
            <form class="table-toolbar withdrawal-period-form" method="get" action="/saidas-suprimentos">
              <input type="hidden" name="filial" value="<%= filial %>">
              <input type="hidden" name="periodo" value="personalizado">
              <label class="search-box">De
                <input type="date" name="dataInicio" value="<%= periodo.dataInicio %>" required>
              </label>
              <label class="search-box">Até
                <input type="date" name="dataFim" value="<%= periodo.dataFim %>" required>
              </label>
              <button class="button-primary" type="submit">Filtrar</button>
            </form>

            <div class="table-scroll">
              <table>
                <thead><tr><th>Data</th><th>Usuário</th><th>Suprimentos retirados</th><th>Total</th></tr></thead>
                <tbody>
                  <% if (saidas.length) { %>
                    <% saidas.forEach((saida) => { %>
                      <tr>
                        <td><%= new Date(saida.data).toLocaleString('pt-BR') %></td>
                        <td><%= saida.usuario %></td>
                        <td><%= saida.itens.map((item) => `${item.nome} (${item.impressora || '-'}): ${item.quantidade}`).join('; ') %></td>
                        <td><%= saida.itens.reduce((total, item) => total + item.quantidade, 0) %></td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr><td class="empty-state" colspan="4">Nenhuma saída encontrada neste período.</td></tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </section>
      </div>
<script src="/js/saidas.js"></script>
<%- include('partials/app-end') %>
